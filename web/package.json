{
  "name": "simple-qr",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bundle:vendor": "vite build --config vite.vendor.config.js && node scripts/copy-vendor-bundle.mjs",
    "dev": "npm run bundle:vendor && vite --host 127.0.0.1 --port 3000 --strictPort",
    "build": "npm run bundle:vendor && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3000 --strictPort"
  },
  "dependencies": {
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "vite": "8.3.1"
  }
}
